fetch-timeout=300000
fetch-retry-mintimeout=20000
fetch-retry-maxtimeout=120000
fetch-retries=5

# packageManager pins pnpm@9 for corepack consumers (Docker build, CI
# action-setup, server) — pnpm 9 is the newest that runs on Node 20.
# Newer standalone pnpm (e.g. local 11.x on Node 24) may keep working
# against the same lockfileVersion 9.0 — warn, don't hard-refuse:
package-manager-strict=false
