# ─── Bringly web (apps/web) environment ──────────────────────────────────────
# Copy to .env.local and adjust for your setup. None of these are consumed yet
# in Task 1 (static shell); the BFF/api-client (Task 3) and auth (Task 11) read
# them. All backend vars point at the Chirawa API.

# Backend origin — NO /api/v1. Base for the same-origin BFF proxy + socket.
BACKEND_ORIGIN=http://localhost:3000

# Backend REST base — INCLUDES /api/v1. Used by the server-side api-client.
BACKEND_API_BASE=http://localhost:3000/api/v1

# Socket.IO origin for live order tracking — NO /api/v1 (see plan §2, Task 14).
SOCKET_URL=http://localhost:3000

# httpOnly session cookie flags (Task 11). In local dev over http, Secure=false.
COOKIE_SECURE=false
COOKIE_DOMAIN=

# NOTE: the Chirawa API dev server also listens on :3000, so run the web dev
# server on a different port, e.g. `next dev -p 3001`, once the BFF proxies to
# the backend (Task 3 onward). Task 1 has no backend dependency.
