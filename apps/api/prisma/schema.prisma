model Settlement {
  id                String           @id @default(uuid()) @db.Uuid
  sellerId          String           @map("seller_id") @db.Uuid
  shopId            String           @map("shop_id") @db.Uuid
  periodDate        DateTime         @map("period_date") @db.Date
  totalOrders       Int              @map("total_orders")
  totalProductPaise Int              @map("total_product_paise")
  platformFeePaise  Int              @default(0) @map("platform_fee_paise")
  netPayablePaise   Int              @map("net_payable_paise")
  status            SettlementStatus @default(pending)
  upiRef            String?          @map("upi_ref") @db.VarChar(100)
  // RazorpayX payout id (pout_*); set once a payout is created (0.3).
  payoutId          String?          @map("payout_id") @db.VarChar(100)
  // Why a settlement failed / why it needs a human — surfaced to admins.
  failureReason     String?          @map("failure_reason") @db.VarChar(255)
