model DeliveryZone {
  id          String   @id @default(uuid()) @db.Uuid
  name        String   @db.VarChar(100)
  description String?  @db.Text
  // Ordered ring of { lat, lng } vertices defining the zone boundary (Chunk 5.1).
  polygon     Json     @default("[]")
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  riderZones RiderZone[]

  @@map("delivery_zones")
}

// A delivery batch — up to 3 nearby same-zone orders grouped to one rider for a
// single trip (Chunk 5.4). status: open | assigned | completed | cancelled.
model Batch {
  id        String   @id @default(uuid()) @db.Uuid
  zoneId    String?  @map("zone_id") @db.Uuid
  riderId   String?  @map("rider_id") @db.Uuid // RiderProfile.id once assigned
  status    String   @default("open") @db.VarChar(20)
  anchorLat Decimal  @map("anchor_lat") @db.Decimal(10, 8) // first order's drop point
  anchorLng Decimal  @map("anchor_lng") @db.Decimal(11, 8)
  closesAt  DateTime @map("closes_at") // accumulation window end
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  orders Order[]

  @@index([status, zoneId])
  @@map("batches")
}

// Links a rider to their primary delivery zone(s) (Chunk 5.1).
model RiderZone {
  id      String @id @default(uuid()) @db.Uuid
  riderId String @map("rider_id") @db.Uuid
  zoneId  String @map("zone_id") @db.Uuid

  rider RiderProfile @relation(fields: [riderId], references: [id], onDelete: Cascade)
  zone  DeliveryZone @relation(fields: [zoneId], references: [id], onDelete: Cascade)

  @@unique([riderId, zoneId])
  @@index([zoneId])
  @@map("rider_zones")
}

