}

model RiderAvailability {
  id         String                  @id @default(uuid()) @db.Uuid
  riderId    String                  @unique @map("rider_id") @db.Uuid
  status     RiderAvailabilityStatus @default(offline)
  lastSeenAt DateTime                @default(now()) @map("last_seen_at")
  currentLat Decimal?                @map("current_lat") @db.Decimal(10, 8)
  currentLng Decimal?                @map("current_lng") @db.Decimal(11, 8)
