generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Enums ────────────────────────────────────────────────────────────────────

enum UserRole {
  customer
  seller
  rider
  admin
}

enum OrderStatus {
  pending_payment
  paid
  confirmed
  preparing
  ready_for_pickup
  picked_up
  out_for_delivery
  delivered
  cancelled
}

enum PaymentMethod {
  upi
  card
  wallet
  cod
}

enum PaymentStatus {
  pending
  captured
  failed
  refunded
  partially_refunded
}

enum StockStatus {
  available
  out_of_stock
  hidden
}

// Moderation gate for a MasterCatalog (dictionary) row before it's publicly
// usable — community/OFF data lands as needs_review until an admin approves it.
enum MasterStatus {
  needs_review
  approved
  rejected
}

enum RiderAvailabilityStatus {
  online
  offline
  on_delivery
}

enum TransactionType {
  customer_payment
  seller_settlement
  refund
  wallet_credit
  wallet_debit
  rider_salary
  rider_cod_collection
  rider_cod_settlement
  platform_fee
  promotional_credit
  referral_credit
}

enum SettlementStatus {
  pending
  processing
  paid
  failed
}

enum NotificationChannel {
  fcm
  sms
  in_app
}

enum AuditAction {
  login
  logout
  profile_update
  refund_issued
  order_cancelled
  admin_action
  payment_event
  security_event
}

// ─── Identity ─────────────────────────────────────────────────────────────────

model User {
  id        String    @id @default(uuid()) @db.Uuid
  phone     String    @unique @db.VarChar(15)
  role      UserRole
  isActive  Boolean   @default(true) @map("is_active")
  deletedAt DateTime? @map("deleted_at")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")

  customerProfile    CustomerProfile?
  sellerProfile      SellerProfile?
  riderProfile       RiderProfile?
  adminProfile       AdminProfile?
  addresses          Address[]
  orders             Order[]             @relation("CustomerOrders")
  refreshTokens      RefreshToken[]
  walletTransactions WalletTransaction[]
  notifications      Notification[]
  auditLogs          AuditLog[]
  referralCode       ReferralCode?
  referralRedemption ReferralRedemption? @relation("ReferredUser")
  promoRedemptions   PromoRedemption[]

  @@index([role])
  @@map("users")
}

model CustomerProfile {
  id            String   @id @default(uuid()) @db.Uuid
  userId        String   @unique @map("user_id") @db.Uuid
  firstName     String?  @map("first_name") @db.VarChar(100)
  lastName      String?  @map("last_name") @db.VarChar(100)
  walletBalance Int      @default(0) @map("wallet_balance")
  loyaltyTier   String   @default("bronze") @map("loyalty_tier") @db.VarChar(20)
  totalOrders   Int      @default(0) @map("total_orders")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("customer_profiles")
}

model SellerProfile {
  id                    String    @id @default(uuid()) @db.Uuid
  userId                String    @unique @map("user_id") @db.Uuid
  ownerName             String    @map("owner_name") @db.VarChar(100)
  upiId                 String?   @map("upi_id") @db.VarChar(100)
  bankAccount           String?   @map("bank_account") @db.VarChar(20)
  bankIfsc              String?   @map("bank_ifsc") @db.VarChar(15)
  gstin                 String?   @db.VarChar(15)
  // RazorpayX contact + fund-account ids, cached after first payout so we don't
  // recreate them every settlement run (0.3).
  razorpayContactId     String?   @map("razorpay_contact_id") @db.VarChar(100)
  razorpayFundAccountId String?   @map("razorpay_fund_account_id") @db.VarChar(100)
  pinHash               String?   @map("pin_hash") @db.VarChar(60)
  pinFailCount          Int       @default(0) @map("pin_fail_count")
  pinLockedUntil        DateTime? @map("pin_locked_until")
  // Times an order was auto-accepted because the seller didn't respond in the
  // acceptance window (Chunk 8.2) — flags chronically unresponsive sellers.
  missedAcceptances     Int       @default(0) @map("missed_acceptances")
  createdAt             DateTime  @default(now()) @map("created_at")
  updatedAt             DateTime  @updatedAt @map("updated_at")

  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  shop        Shop?
  settlements Settlement[]

  @@map("seller_profiles")
}

model RiderProfile {
  id                     String    @id @default(uuid()) @db.Uuid
  userId                 String    @unique @map("user_id") @db.Uuid
  fullName               String    @map("full_name") @db.VarChar(100)
  vehicleNumber          String?   @map("vehicle_number") @db.VarChar(20)
  licenseUrl             String?   @map("license_url")
  rcUrl                  String?   @map("rc_url")
  securityDepositBalance Int       @default(0) @map("security_deposit_balance")
  monthlySalaryPaise     Int       @default(750000) @map("monthly_salary_paise")
  pinHash                String?   @map("pin_hash") @db.VarChar(60)
  pinFailCount           Int       @default(0) @map("pin_fail_count")
  pinLockedUntil         DateTime? @map("pin_locked_until")
  codBalancePaise        Int       @default(0) @map("cod_balance_paise")
  createdAt              DateTime  @default(now()) @map("created_at")
  updatedAt              DateTime  @updatedAt @map("updated_at")

  user             User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  availability     RiderAvailability?
  assignments      DeliveryAssignment[]
  riderSettlements RiderSettlement[]
  zones            RiderZone[]

  @@map("rider_profiles")
}

model AdminProfile {
  id              String   @id @default(uuid()) @db.Uuid
  userId          String   @unique @map("user_id") @db.Uuid
  displayName     String   @map("display_name") @db.VarChar(100)
  permissionLevel Int      @default(1) @map("permission_level")
  ipAllowlist     String[] @map("ip_allowlist")
  pinHash         String?  @map("pin_hash") @db.VarChar(60)
  totpSecret      String?  @map("totp_secret")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("admin_profiles")
}

// ─── Catalog ──────────────────────────────────────────────────────────────────

model Shop {
  id                       String   @id @default(uuid()) @db.Uuid
  sellerId                 String   @unique @map("seller_id") @db.Uuid
  name                     String   @db.VarChar(100)
  description              String?  @db.Text
  logoUrl                  String?  @map("logo_url")
  coverImageUrl            String?  @map("cover_image_url")
  lat                      Decimal  @db.Decimal(10, 8)
  lng                      Decimal  @db.Decimal(11, 8)
  address                  String   @db.VarChar(255)
  isActive                 Boolean  @default(false) @map("is_active")
  isOpen                   Boolean  @default(false) @map("is_open")
  isFeatured               Boolean  @default(false) @map("is_featured")
  // Per-shop commission rate as a fraction (0.13 = 13%). Overrides the shop's
  // Category rate. Defaults to 0 — set from admin for Chirawa Special shops.
  commissionRate           Decimal  @default(0) @map("commission_rate") @db.Decimal(5, 4)
  openTime                 String   @default("09:00") @map("open_time") @db.VarChar(5)
  closeTime                String   @default("22:00") @map("close_time") @db.VarChar(5)
  estimatedDeliveryMinutes Int      @default(30) @map("estimated_delivery_minutes")
  // Average packing/prep time used by the server ETA (ETA MVP Phase 1) — distinct from
  // the marketing estimatedDeliveryMinutes shown on shop cards.
  prepTimeMinutes          Int      @default(8) @map("prep_time_minutes")
  operatingHours           Json     @default("{}") @map("operating_hours")
  createdAt                DateTime @default(now()) @map("created_at")
  updatedAt                DateTime @updatedAt @map("updated_at")

  seller      SellerProfile @relation(fields: [sellerId], references: [id])
  categories  Category[]
  products    Product[]
  orders      Order[]
  settlements Settlement[]

  @@index([isActive])
  @@index([isOpen])
  @@index([isFeatured])
  @@index([lat, lng])
  @@map("shops")
}

model Category {
  id             String   @id @default(uuid()) @db.Uuid
  shopId         String   @map("shop_id") @db.Uuid
  parentId       String?  @map("parent_id") @db.Uuid
  name           String   @db.VarChar(100)
  sortOrder      Int      @default(0) @map("sort_order")
  isActive       Boolean  @default(true) @map("is_active")
  // Category-level commission rate as a fraction (0.13 = 13%). A shop's own
  // commissionRate (if > 0) overrides this. Defaults to 0.
  commissionRate Decimal  @default(0) @map("commission_rate") @db.Decimal(5, 4)
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  shop     Shop       @relation(fields: [shopId], references: [id], onDelete: Cascade)
  parent   Category?  @relation("CategoryHierarchy", fields: [parentId], references: [id])
  children Category[] @relation("CategoryHierarchy")
  products Product[]

  @@index([shopId, sortOrder])
  @@map("categories")
}

model Product {
  id          String      @id @default(uuid()) @db.Uuid
  shopId      String      @map("shop_id") @db.Uuid
  categoryId  String?     @map("category_id") @db.Uuid
  name        String      @db.VarChar(200)
  description String?     @db.Text
  price       Int
  mrpPaise    Int?        @map("mrp_paise")
  // Numeric stock (Phase 1.5) — OPT-IN. null => not tracked numerically (status
  // only); a number => tracked, decremented inside checkout to prevent
  // over-selling, 0 => out_of_stock. Variants carry their own (non-null) stockQty.
  stockQty    Int?        @map("stock_qty")
  lowStockAt  Int?        @map("low_stock_at")
  stockStatus StockStatus @default(available) @map("stock_status")
  isActive    Boolean     @default(true) @map("is_active")
  sortOrder   Int         @default(0) @map("sort_order")
  unit        String?     @db.VarChar(50)
  // GTIN/EAN join key (Catalog Engine Phase 0). Nullable — only set for barcoded
  // goods; NOT unique (the same GTIN legitimately recurs as one row per shop).
  barcode     String?     @db.VarChar(14)
  // Link to the global MasterCatalog "dictionary" row this shop-product realizes.
  // Nullable — products added before/without a barcode flow through the manual path.
  masterId    String?     @map("master_id") @db.Uuid
  // Free-form product highlights shown as chips on the detail page, e.g.
  // [{ "label": "Shelf Life", "value": "150 days" }, { "label": "Flavour", "value": "Spicy" }]
  attributes  Json?       @map("attributes")
  createdAt   DateTime    @default(now()) @map("created_at")
  updatedAt   DateTime    @updatedAt @map("updated_at")

  shop           Shop             @relation(fields: [shopId], references: [id], onDelete: Cascade)
  category       Category?        @relation(fields: [categoryId], references: [id])
  master         MasterCatalog?   @relation(fields: [masterId], references: [id])
  images         ProductImage[]
  variants       ProductVariant[]
  cartItems      CartItem[]
  orderItems     OrderItem[]
  stockUpdateLog StockUpdateLog[]
  inventoryState InventoryState?

  @@index([shopId, stockStatus, isActive])
  @@index([categoryId])
  @@index([name])
  @@index([barcode])
  // Drives the cross-shop aggregation query (group by master, in-stock + active).
  @@index([masterId, stockStatus, isActive])
  @@map("products")
}

// Optional pack-size / SKU variants for a product (e.g. "500 ml", "1 L").
// A product with no ProductVariant rows is sold as a single unit at Product.price
// (existing behavior). When a variant is chosen, its price/name override.
model ProductVariant {
  id        String  @id @default(uuid()) @db.Uuid
  productId String  @map("product_id") @db.Uuid
  name      String  @db.VarChar(60) // "500 ml", "1 L", "Pack of 6"
  price     Int // paise
  mrpPaise  Int?    @map("mrp_paise")
  stockQty  Int     @default(0) @map("stock_qty")
  sku       String? @db.VarChar(60)
  sortOrder Int     @default(0) @map("sort_order")
  isActive  Boolean @default(true) @map("is_active")

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId, sortOrder])
  @@map("product_variants")
}

model ProductImage {
  id          String   @id @default(uuid()) @db.Uuid
  productId   String   @map("product_id") @db.Uuid
  url         String
  sortOrder   Int      @default(0) @map("sort_order")
  // Provenance for legal/attribution + one-click takedowns (Catalog Engine Phase
  // 0). Populated by the image pipeline (Phase 1) — null for pre-existing rows.
  source      String?  @db.VarChar(50) // 'open_food_facts' | 'distributor' | 'manual'
  license     String?  @db.VarChar(50) // 'CC-BY-SA' | 'owned'
  attribution String? // e.g. the OFF product URL, for the credits page
  createdAt   DateTime @default(now()) @map("created_at")

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@map("product_images")
}

// NEW (Catalog Engine Phase 0) — the global product "dictionary", one row per
// real-world product keyed by barcode (GTIN). Canonical name/image/MRP that
// per-shop Product rows reference. NOT sellable — a lookup/enrichment table only.
model MasterCatalog {
  id                    String       @id @default(uuid()) @db.Uuid
  barcode               String       @unique @db.VarChar(14) // EAN-13/UPC — the join key
  name                  String       @db.VarChar(200)
  brand                 String?      @db.VarChar(120)
  unit                  String?      @db.VarChar(50)
  mrpPaise              Int?         @map("mrp_paise")
  categoryName          String?      @map("category_name") // generic, deduped-by-name like existing categories
  imageUrl              String?      @map("image_url") // canonical, on OUR R2 (never hotlinked)
  imageSource           String?      @map("image_source") // 'open_food_facts' | 'distributor' | 'manual'
  imageLicense          String?      @map("image_license") // 'CC-BY-SA' | 'owned'
  imageAttribution      String?      @map("image_attribution") // OFF product URL for the credits page
  status                MasterStatus @default(needs_review) // gate before it's publicly usable
  // Enrichment tracking (Catalog Engine Phase 2). enrichmentStatus: null = never
  // attempted, 'enriched' = image set from a source, 'needs_manual' = no source
  // match (a human photo is needed), 'error' = transient failure (retried next
  // run). Drives resumability + the Phase 7 coverage dashboard.
  enrichmentStatus      String?      @map("enrichment_status") @db.VarChar(20)
  enrichmentAttemptedAt DateTime?    @map("enrichment_attempted_at")
  enrichmentNote        String?      @map("enrichment_note") // last skip/failure reason
  createdAt             DateTime     @default(now()) @map("created_at")
  updatedAt             DateTime     @updatedAt @map("updated_at")

  products Product[]

  @@index([name])
  @@index([status])
  @@index([enrichmentStatus])
  @@map("master_catalog")
}

// NEW (Catalog Engine Phase 0) — demand capture ("Request this item"). Captures
// minimal PII (pincode only) so unmet demand can rank the sourcing roadmap.
model ProductRequest {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String?  @map("user_id") @db.Uuid // null = anonymous
  rawText   String?  @map("raw_text") // free-text wish
  barcode   String?  @db.VarChar(14)
  masterId  String?  @map("master_id") @db.Uuid
  pincode   String?  @db.VarChar(10)
  // Restock "notify me" (Catalog Engine Phase 6). When notifyOnRestock is set, the
  // requester is FCM'd once the item's master is back in stock; notifiedAt stamps
  // that send so the fan-out stays at-most-once even if the trigger re-fires.
  notifyOnRestock Boolean   @default(false) @map("notify_on_restock")
  notifiedAt      DateTime? @map("notified_at")
  createdAt DateTime @default(now()) @map("created_at")

  @@index([masterId])
  @@index([barcode])
  @@index([createdAt])
  @@map("product_requests")
}

// NEW (Catalog Engine Phase 3) — "report wrong image". A seller/customer flags a
// product or master image as wrong; on report the linked master is re-gated to
// needs_review (leaves the public pool until fixed). Feeds the Phase 7 moderation
// queue; resolvedAt marks it handled. Bare columns (no FKs), like ProductRequest.
model ImageReport {
  id           String    @id @default(uuid()) @db.Uuid
  productId    String?   @map("product_id") @db.Uuid
  masterId     String?   @map("master_id") @db.Uuid
  reportedById String?   @map("reported_by_id") @db.Uuid // null = anonymous
  reason       String?   @db.VarChar(255)
  resolvedAt   DateTime? @map("resolved_at")
  createdAt    DateTime  @default(now()) @map("created_at")

  @@index([masterId])
  @@index([resolvedAt])
  @@index([createdAt])
  @@map("image_reports")
}

// ─── Address ──────────────────────────────────────────────────────────────────

model Address {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  label     String?  @db.VarChar(50)
  street    String   @db.VarChar(255)
  landmark  String   @db.VarChar(255)
  locality  String   @db.VarChar(100)
  city      String   @default("Chirawa") @db.VarChar(100)
  pincode   String   @db.VarChar(10)
  lat       Decimal  @db.Decimal(10, 8)
  lng       Decimal  @db.Decimal(11, 8)
  // Receiver / contact details (Address redesign v2). contactType is
  // "myself" | "other"; receiver fields hold who the order is delivered to when
  // it differs from the account holder. mapsLink is an optional Google Maps URL.
  contactType   String? @default("myself") @map("contact_type") @db.VarChar(20)
  receiverName  String? @map("receiver_name")  @db.VarChar(100)
  receiverPhone String? @map("receiver_phone") @db.VarChar(20)
  mapsLink      String? @map("maps_link")      @db.Text
  isDefault Boolean  @default(false) @map("is_default")
  isDeleted Boolean  @default(false) @map("is_deleted")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  orders Order[]

  @@index([userId, isDefault])
  @@map("addresses")
}

// ─── Cart ─────────────────────────────────────────────────────────────────────

model Cart {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @unique @map("user_id") @db.Uuid
  shopId    String?  @map("shop_id") @db.Uuid
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  items CartItem[]

  @@map("carts")
}

model CartItem {
  id             String   @id @default(uuid()) @db.Uuid
  cartId         String   @map("cart_id") @db.Uuid
  productId      String   @map("product_id") @db.Uuid
  quantity       Int
  unitPriceAtAdd Int      @map("unit_price_at_add")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  cart    Cart    @relation(fields: [cartId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id])

  @@unique([cartId, productId])
  @@map("cart_items")
}

// ─── Orders ───────────────────────────────────────────────────────────────────

model Order {
  id         String @id @default(uuid()) @db.Uuid
  customerId String @map("customer_id") @db.Uuid
  shopId     String @map("shop_id") @db.Uuid

  // SNAPSHOT — full address copied at order time, never FK to addresses
  // This makes the order record immutable even if address is later edited
  deliveryStreet   String  @map("delivery_street") @db.VarChar(255)
  deliveryLandmark String  @map("delivery_landmark") @db.VarChar(255)
  deliveryLocality String  @map("delivery_locality") @db.VarChar(100)
  deliveryCity     String  @map("delivery_city") @db.VarChar(100)
  deliveryPincode  String  @map("delivery_pincode") @db.VarChar(10)
  deliveryLat      Decimal @map("delivery_lat") @db.Decimal(10, 8)
  deliveryLng      Decimal @map("delivery_lng") @db.Decimal(11, 8)
  // Optional receiver contact — set when ordering for someone else; the rider
  // calls this instead of the account owner. Editable before pickup.
  receiverName     String? @map("receiver_name") @db.VarChar(100)
  receiverPhone    String? @map("receiver_phone") @db.VarChar(20)

  // Pricing — all in paise (integer, never float)
  cartSubtotalAtPricing Int     @map("cart_subtotal_at_pricing")
  deliveryFee           Int     @map("delivery_fee")
  discount              Int     @default(0)
  totalAmount           Int     @map("total_amount")
  feeRuleVersion        Int     @map("fee_rule_version")
  distanceKm            Decimal @map("distance_km") @db.Decimal(8, 3)
  distanceSource        String  @default("google_maps") @map("distance_source") @db.VarChar(30)

  // Status & payment
  status        OrderStatus   @default(pending_payment)
  paymentMethod PaymentMethod @map("payment_method")

  // Currently assigned rider (denormalized for quick lookup)
  riderId String? @map("rider_id") @db.Uuid

  // COD tracking
  codCollectedPaise Int @default(0) @map("cod_collected_paise")

  // Optional references
  promoCodeId String? @map("promo_code_id") @db.Uuid
  addressId   String? @map("address_id") @db.Uuid
  batchId     String? @map("batch_id") @db.Uuid // delivery batch (Chunk 5.4)
  // Ties this per-shop child order to the ONE customer-facing OrderGroup it was
  // split from (Catalog Engine Phase 0/5). Nullable — legacy single-shop orders
  // and orders placed before aggregation have no group.
  groupId     String? @map("group_id") @db.Uuid

  // Timestamps
  confirmedAt      DateTime? @map("confirmed_at")
  sellerAcceptedAt DateTime? @map("seller_accepted_at")
  preparingAt      DateTime? @map("preparing_at")
  readyAt          DateTime? @map("ready_at")
  pickedUpAt       DateTime? @map("picked_up_at")
  outForDeliveryAt DateTime? @map("out_for_delivery_at")
  deliveredAt      DateTime? @map("delivered_at")
  cancelledAt      DateTime? @map("cancelled_at")
  cancelReason     String?   @map("cancel_reason") @db.VarChar(255)

  // Server-computed delivery ETA (ETA MVP Phase 1). estimatedDeliveryAt is the promise;
  // etaSpreadSeconds is the ± half-width shown as a range; etaSource ∈ 'prep_road' | 'fallback'.
  estimatedDeliveryAt DateTime? @map("estimated_delivery_at")
  etaSpreadSeconds    Int?      @map("eta_spread_seconds")
  etaComputedAt       DateTime? @map("eta_computed_at")
  etaSource           String?   @map("eta_source") @db.VarChar(20)

  // Checkout-resolver decision snapshot (Inventory Engine) — why each line went
  // to which shop (candidates, gates, drops). Written on the fee-carrier child
  // order only; answers "why did we pick Seller A?" from data, not vibes.
  resolverTrace Json? @map("resolver_trace")

  // Customer rating (post-delivery)
  rating        Int?      @map("rating")
  ratingComment String?   @map("rating_comment") @db.VarChar(500)
  ratedAt       DateTime? @map("rated_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  customer            User                 @relation("CustomerOrders", fields: [customerId], references: [id])
  shop                Shop                 @relation(fields: [shopId], references: [id])
  address             Address?             @relation(fields: [addressId], references: [id])
  promoCode           PromoCode?           @relation(fields: [promoCodeId], references: [id])
  batch               Batch?               @relation(fields: [batchId], references: [id])
  group               OrderGroup?          @relation(fields: [groupId], references: [id])
  items               OrderItem[]
  statusHistory       OrderStatusHistory[]
  payments            Payment[]
  deliveryAssignments DeliveryAssignment[]

  @@index([customerId, createdAt(sort: Desc)])
  @@index([status, createdAt])
  @@index([status, estimatedDeliveryAt])
  @@index([shopId, createdAt(sort: Desc)])
  @@index([riderId, status])
  @@index([groupId])
  @@map("orders")
}

// NEW (Catalog Engine Phase 0) — unifies the per-shop child orders into ONE
// customer-facing order. The existing per-shop split (orders.service) stays; the
// group only gives the customer one order + one tracking view on top of N children.
model OrderGroup {
  id         String   @id @default(uuid()) @db.Uuid
  customerId String   @map("customer_id") @db.Uuid
  createdAt  DateTime @default(now()) @map("created_at")

  orders Order[]

  @@map("order_groups")
}

model OrderItem {
  id          String   @id @default(uuid()) @db.Uuid
  orderId     String   @map("order_id") @db.Uuid
  productId   String   @map("product_id") @db.Uuid
  productName String   @map("product_name") @db.VarChar(200)
  unitPrice   Int      @map("unit_price")
  quantity    Int
  subtotal    Int
  // Per-line fulfillment (Catalog Engine Phase 5 safety net). 'fulfilled' =
  // normal; 'unavailable_refunded' = the rider found this item out of stock at
  // pickup, so the line was refunded (prepaid) / deducted from cash due (COD) and
  // its `refundedPaise` recorded. The rest of the order still proceeds.
  fulfillmentStatus String @default("fulfilled") @map("fulfillment_status") @db.VarChar(20)
  refundedPaise     Int    @default(0) @map("refunded_paise")
  // Inventory verification lifecycle (Inventory Engine).
  //   accept_verify_requested — flagged at placement (low confidence / hold lost):
  //                             the seller accept screen shows a chip for this line
  //   accept_confirmed        — seller confirmed (explicit chip tap or implicit accept)
  //   rider_verify_requested  — auto-accepted while flagged: rider should confirm on shelf
  // NULL = normal line, nothing to verify.
  verificationFlag String? @map("verification_flag") @db.VarChar(30)
  createdAt   DateTime @default(now()) @map("created_at")

  order   Order   @relation(fields: [orderId], references: [id])
  product Product @relation(fields: [productId], references: [id])

  @@index([orderId])
  @@map("order_items")
}

model OrderStatusHistory {
  id            String      @id @default(uuid()) @db.Uuid
  orderId       String      @map("order_id") @db.Uuid
  status        OrderStatus
  changedByRole UserRole    @map("changed_by_role")
  changedById   String      @map("changed_by_id") @db.Uuid
  reason        String?     @db.VarChar(255)
  changedAt     DateTime    @default(now()) @map("changed_at")

  order Order @relation(fields: [orderId], references: [id])

  @@index([orderId, changedAt])
  @@map("order_status_history")
}

// ─── Payments ─────────────────────────────────────────────────────────────────

model Payment {
