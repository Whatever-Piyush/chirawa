# ── Server ──────────────────────────────────────────────────────────────────
# REQUIRED, no default — the API refuses to boot if NODE_ENV is unset
# (development | test | production). Verify any env with: pnpm env:check
NODE_ENV=development
PORT=3000
HOST=0.0.0.0

# ── Database (matches docker-compose.yml) ────────────────────────────────────
DATABASE_URL=postgresql://chirawa:chirawa_dev_password@localhost:5432/chirawa_development

# ── Redis (matches docker-compose.yml) ───────────────────────────────────────
REDIS_URL=redis://:chirawa_redis_dev_password@localhost:6379

# ── JWT Keys (generate with: node scripts/generate-dev-keys.mjs) ─────────────
# RS256 asymmetric keys — private key signs tokens, public key verifies them
JWT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nPASTE_GENERATED_KEY_HERE\n-----END PRIVATE KEY-----"
JWT_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\nPASTE_GENERATED_KEY_HERE\n-----END PUBLIC KEY-----"
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN_DAYS=7

# ── Payments launch flag (Phase 5 — COD-only launch) ─────────────────────────
# false (default) = customers can only order COD; the API rejects non-COD orders
# and refuses to create Razorpay payment orders. Placeholder RAZORPAY_* creds
# then only WARN at production boot (webhooks reject fail-closed regardless).
# true = online payments live; real RAZORPAY_* creds become REQUIRED in prod.
PAYMENTS_ONLINE_ENABLED=false

# ── Razorpay (razorpay.com dashboard) ────────────────────────────────────────
RAZORPAY_KEY_ID=rzp_test_placeholder
RAZORPAY_KEY_SECRET=placeholder_secret
RAZORPAY_WEBHOOK_SECRET=placeholder_webhook
# RazorpayX payout source account (seller settlements). Placeholder = payouts
# stay pending (recorded, moved manually) — warned at production boot.
RAZORPAYX_ACCOUNT_NUMBER=placeholder

# ── Firebase FCM (Firebase Console > Project Settings > Service Accounts) ────
FCM_SERVICE_ACCOUNT_JSON={}

# ── Fast2SMS (fast2sms.com) ───────────────────────────────────────────────────
FAST2SMS_API_KEY=placeholder

# ── Mappls / MapmyIndia (auth.mappls.com/console) ────────────────────────────
# The ONLY maps provider server-side (Phase 5 decision — never Google).
# client_id/secret mint the OAuth token for place Autosuggest (/geo/places);
# the REST key drives reverse geocoding (/geo/reverse) and the road-distance
# matrix (pricing). Restrict the REST key to the server IP in the console.
# While placeholders: /geo/* returns empty (app falls back to its on-device
# geocoder) and road distance falls back to haversine×1.4 — warned at prod boot.
MAPPLS_CLIENT_ID=placeholder
MAPPLS_CLIENT_SECRET=placeholder
MAPPLS_REST_KEY=placeholder

# ── Cloudflare R2 (Cloudflare Dashboard > R2) ────────────────────────────────
R2_ACCOUNT_ID=placeholder
R2_ACCESS_KEY_ID=placeholder
R2_SECRET_ACCESS_KEY=placeholder
R2_BUCKET_NAME=chirawa-assets
R2_PUBLIC_URL=http://localhost:3000

# ── App ───────────────────────────────────────────────────────────────────────
APP_NAME=Chirawa
FRONTEND_URLS=http://localhost:3001,http://localhost:3002
COD_FLOAT_CAP_PAISE=200000

# Delivery hours (IST, 0–24). Orders outside the window are rejected at checkout.
# Leave UNSET for the real launch hours (9 AM – 8 PM). During the building phase,
# run 24/7 by setting OPEN=0 and CLOSE=24. Keep in step with the customer app's
# EXPO_PUBLIC_ALWAYS_OPEN.
# OPERATING_HOURS_OPEN=0
# OPERATING_HOURS_CLOSE=24

# ── Database backups (Production Hardening Phase 1 — see docs/DISASTER_RECOVERY.md)
# Nightly pg_dump → R2. BACKUP_R2_BUCKET is REQUIRED for durable backups and
# MUST be a separate PRIVATE bucket — never the public assets bucket above
# (the script refuses R2_BUCKET_NAME). Credentials default to the R2_* values;
# set BACKUP_R2_ACCESS_KEY_ID / BACKUP_R2_SECRET_ACCESS_KEY /
# BACKUP_R2_ACCOUNT_ID to use a least-privilege token scoped to this bucket.
BACKUP_R2_BUCKET=chirawa-db-backups
BACKUP_RETENTION_DAYS=30                  # delete R2 backups older than this (0 = keep forever)
BACKUP_PREFIX=db-backups                  # key prefix inside the bucket
BACKUP_LOCAL_DIR=                         # staging dir for dumps (default: OS tmp)
# How pg tools are invoked. Native binaries by default; on a Docker-Postgres
# host use e.g.:  docker exec chirawa_postgres pg_dump   (note -i for restore/psql stdin)
BACKUP_PG_DUMP_COMMAND=pg_dump
BACKUP_PG_RESTORE_COMMAND=pg_restore
BACKUP_PSQL_COMMAND=psql
# Dead-man's-switch (healthchecks.io etc.): pinged on success, <url>/fail on failure.
BACKUP_HEALTHCHECK_URL=
# Pre-migration backup mode for db:migrate:prod: auto | require | attempt | skip
# auto = require in production, attempt elsewhere. skip is break-glass only.
BACKUP_BEFORE_MIGRATE=auto

# Worker dead-man's switch (P1-9) — healthchecks.io-style ping URL
WORKER_HEARTBEAT_URL=
