{
  "expo": {
    "name": "Bringly Rider",
    "slug": "chirawa-rider",
    "owner": "aaaaaadiii",
    "version": "1.0.0",
    "sdkVersion": "54.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#27AE60"
    },
    "android": {
      "package": "in.bringly.rider",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#27AE60"
      },
      "googleServicesFile": "./google-services.json",
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ],
      "blockedPermissions": [
        "android.permission.ACCESS_BACKGROUND_LOCATION"
      ]
    },
    "ios": {
      "bundleIdentifier": "in.bringly.rider"
    },
    "plugins": [
      "expo-secure-store",
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Rider location delivery ke liye zaruri hai",
          "isAndroidForegroundServiceEnabled": true
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#27AE60",
          "sounds": []
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "ccfa51fb-0f7c-4a96-bf29-0e2703bb1c8a"
      }
    }
  }
}
