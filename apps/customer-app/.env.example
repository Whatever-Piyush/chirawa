# Per-machine dev API host. Copy this file to `.env` and set your value.
#   cp .env.example .env
#
#   • Physical device (same Wi-Fi) → your Mac's LAN IP: `ipconfig getifaddr en0`
#   • Android emulator             → 10.0.2.2
#   • iOS simulator                → localhost
#
# Only used in __DEV__ builds; production points at https://api.chirawa.in.
EXPO_PUBLIC_API_HOST= 10.162.51.76

# Android map TILE-RENDER key (injected into the manifest by app.config.js —
# never commit a real key). Restrict it in the Google Cloud console to this
# package (com.chirawa.customer) + signing SHA-1 + "Maps SDK for Android" only.
# For EAS builds set it as an EAS environment variable instead of here.
# All maps API calls (search/geocoding/distance) are Mappls, server-side.
GOOGLE_MAPS_ANDROID_API_KEY=

# Building phase only: treat the store as always open (24/7) so checkout isn't
# time-gated while testing. Leave UNSET for the real launch hours (9 AM – 8 PM).
# Baked at build time — set BEFORE building, and rebuild after changing. Keep in
# step with the backend's OPERATING_HOURS_OPEN/CLOSE.
# EXPO_PUBLIC_ALWAYS_OPEN=true


