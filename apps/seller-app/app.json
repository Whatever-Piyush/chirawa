{
  "expo": {
    "name": "Bringly Seller",
    "slug": "chirawa-seller",
    "version": "1.0.0",
    "sdkVersion": "54.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#1A1A1A"
    },
    "android": {
      "package": "com.chirawa.seller",
      "adaptiveIcon": {
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundColor": "#1A1A1A"
      },
      "googleServicesFile": "./google-services.json",
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS"
      ]
    },
    "plugins": [
      "expo-secure-store",
      "expo-av",
      [
        "expo-notifications",
        {
          "color": "#FF3E6C",
          "sounds": []
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Bringly ko product barcode scan karne ke liye camera chahiye."
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "af29f665-a0e7-4f50-912f-ac041760145b"
      }
    }
  }
}
