{
  "expo": {
    "name": "Bringly Seller",
    "slug": "chirawa-seller",
    "owner": "piyushlatta",
    "version": "1.0.0",
    "sdkVersion": "54.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#1A1A1A"
    },
    "android": {
      "package": "in.bringly.seller",
      "adaptiveIcon": {
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundColor": "#1A1A1A"
      },
      "googleServicesFile": "./google-services.json",
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.CAMERA"
      ]
    },
    "ios": {
      "bundleIdentifier": "in.bringly.seller"
    },
    "plugins": [
      "expo-secure-store",
      "expo-av",
      [
        "expo-notifications",
        {
          "color": "#FF3E6C",
          "sounds": []
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Bringly ko product barcode scan karne ke liye camera chahiye."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Bringly ko product ki photo lagane ke liye gallery chahiye.",
          "cameraPermission": "Bringly ko product ki photo lene ke liye camera chahiye."
        }
      ]
    ]
  }
}
