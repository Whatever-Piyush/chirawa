# scripts/harness/.env.sandbox.example — REFERENCE template (committed).
# Copy to scripts/harness/.env.sandbox (git-ignored by the root `.env.*` rule) and fill
# TEST/sandbox creds. NEVER put production secrets here.
# Load before a run:   set -a; . scripts/harness/.env.sandbox; set +a
#
# Findings served: F1 (sandbox-gate money paths), F8 (env isolation).

# ── Isolation (consumed by 00_preflight.sh) ───────────────────────────────────
HARNESS_DB=1                       # explicit opt-in; 00_preflight aborts without it
NODE_ENV=development               # OTP dev-bypass (123456) requires 'development'
HARNESS_MODE=sandbox               # dev-mock | sandbox  (sandbox => money blocks GATING)
HARNESS_ALLOW_HOSTS="localhost 127.0.0.1 ::1 chirawa_postgres chirawa_redis"
HARNESS_DB_NAMES="chirawa_harness" # disposable DB name allowlist
HARNESS_MAX_ORDERS=500             # row ceiling — refuses a populated/shared DB
HARNESS_MAX_KEYS=5000              # Redis DBSIZE ceiling

# ── Disposable harness DB + Redis (must NOT be production) ─────────────────────
DATABASE_URL=postgresql://chirawa:chirawa_dev_password@localhost:5432/chirawa_harness
REDIS_URL=redis://:chirawa_redis_dev_password@localhost:6379

# ── API under test ────────────────────────────────────────────────────────────
API=http://localhost:3000/api/v1

# ── Razorpay TEST keys (sandbox) — non-placeholder => money blocks become GATING ─
RAZORPAY_KEY_ID=rzp_test_REPLACE
RAZORPAY_KEY_SECRET=REPLACE
RAZORPAY_WEBHOOK_SECRET=REPLACE
RAZORPAYX_ACCOUNT_NUMBER=REPLACE

# ── Optional: FCM service account (empty => dev console push) ──────────────────
# FCM_SERVICE_ACCOUNT_JSON=

# ── Optional overrides (clients) ──────────────────────────────────────────────
# H_PSQL=psql
# H_REDIS=redis-cli
# H_CURL=curl
