# ==============================================================================
# BRINGLY (Chirawa) — Monorepo environment reference
# ==============================================================================
# This file documents EVERY environment variable used across the monorepo.
# Each app reads its OWN .env file (this root file is documentation + a copy
# source). After cloning:
#
#   cp .env.example apps/api/.env            # then fill the API section
#   cp .env.example apps/customer-app/.env   # then fill the EXPO section
#   cp .env.example apps/seller-app/.env     # (same EXPO section)
#   cp .env.example apps/rider-app/.env      # (same EXPO section)
#
# NEVER commit a real .env. NEVER hardcode any of these values in source.
# ==============================================================================


# ──────────────────────────────────────────────────────────────────────────────
# API  (apps/api/.env)  — Fastify backend
# ──────────────────────────────────────────────────────────────────────────────

# ── Server ──
# NODE_ENV is REQUIRED with no default — the API refuses to boot without it.
# In production, placeholder credentials below also hard-fail boot (Razorpay,
# Fast2SMS, R2) and localhost URLs are rejected. Preflight any env with:
#   pnpm --filter @chirawa/api env:check
NODE_ENV=development                 # development | test | production
PORT=3000                            # API listen port
HOST=0.0.0.0                         # bind address (0.0.0.0 so devices on LAN can reach it)

# ── Database (Postgres — matches docker-compose.yml) ──
DATABASE_URL=postgresql://chirawa:chirawa_dev_password@localhost:5432/chirawa_development

# ── Redis (cart, rider location, cache — matches docker-compose.yml) ──
REDIS_URL=redis://:chirawa_redis_dev_password@localhost:6379

# ── JWT (RS256 asymmetric — generate with: node scripts/generate-dev-keys.mjs) ──
# Private key SIGNS tokens, public key VERIFIES them. Keep \n escapes on one line.
JWT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nPASTE_GENERATED_KEY_HERE\n-----END PRIVATE KEY-----"
JWT_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\nPASTE_GENERATED_KEY_HERE\n-----END PUBLIC KEY-----"
JWT_ACCESS_EXPIRES_IN=15m            # access token lifetime
JWT_REFRESH_EXPIRES_IN_DAYS=7        # refresh token lifetime (days)

# ── Razorpay (dashboard.razorpay.com) — UPI/online payments ──
# Dev uses test keys; production REQUIRES live keys before going live (Chunk 3/11).
RAZORPAY_KEY_ID=rzp_test_placeholder
RAZORPAY_KEY_SECRET=placeholder_secret
RAZORPAY_WEBHOOK_SECRET=placeholder_webhook   # verifies webhook payloads (Chunk 3)

# ── Firebase Cloud Messaging (Firebase Console > Service Accounts) — push notifs ──
# Paste the full service-account JSON as a single line. In dev with {} pushes are
# logged to the API console instead of delivered.
FCM_SERVICE_ACCOUNT_JSON={}

# ── Fast2SMS (fast2sms.com) — OTP + SMS alerts ──
FAST2SMS_API_KEY=placeholder

# ── Mappls / MapmyIndia (auth.mappls.com/console) — the only maps provider ──
# Phase 5 decision: the backend uses Mappls exclusively (never Google).
# Powers /geo/autocomplete (place search), /geo/reverse (reverse geocoding), and
# the road-distance matrix (pricing). client_id + client_secret mint a 24h OAuth
# token (Autosuggest); the REST key drives rev_geocode + distance_matrix.
# Leave as 'placeholder' to disable: geo falls back to the on-device geocoder,
# distance to haversine×1.4. (The customer app's Android map TILES still render
# via a client-side Google Maps SDK key — see EXPO_PUBLIC_GOOGLE_MAPS_API_KEY.)
MAPPLS_CLIENT_ID=placeholder
MAPPLS_CLIENT_SECRET=placeholder
MAPPLS_REST_KEY=placeholder

# ── Cloudflare R2 (Cloudflare Dashboard > R2) — image storage (shops/products) ──
# Used by the admin image-upload endpoint (Chunk 1). R2_PUBLIC_URL is the public
# base URL that product/shop imageUrls are built from.
R2_ACCOUNT_ID=placeholder
R2_ACCESS_KEY_ID=placeholder
R2_SECRET_ACCESS_KEY=placeholder
R2_BUCKET_NAME=chirawa-assets
R2_PUBLIC_URL=http://localhost:3000
# Canonical fallback tile for missing images (catalog engine Phase 1).
PLACEHOLDER_IMAGE_URL=https://placehold.co/1200x1200/EEEEEE/999999.webp?text=No+Image

# ── Catalog enrichment (Phase 2) ──────────────────────────────────────────────
# Local Open Food Facts JSONL bulk dump for image enrichment (download from
# https://world.openfoodfacts.org/data). Empty = no dump → items marked
# needs_manual. Bulk enrichment never calls the live OFF API (rate-limit/ban risk).
OFF_DUMP_PATH=
# Descriptive User-Agent for the live OFF API (Phase 3 seller-scan fallback).
# OFF requires identifying yourself with a real contact.
OFF_USER_AGENT=Bringly/1.0 (catalog@bringly.example)

# ── App config ──
APP_NAME=Chirawa
# Comma-separated allowed CORS origins (admin dashboard, web tools)
FRONTEND_URLS=http://localhost:3001,http://localhost:3002
COD_FLOAT_CAP_PAISE=200000           # rider cash-on-delivery float cap (₹2000 in paise)

# ── Sentry (sentry.io) — crash reporting (Chunk 10/11; optional in dev) ──
# Worker dead-man's switch (P1-9): healthchecks.io-style URL pinged every 60s
# by the worker; empty = disabled (warns at production boot).
WORKER_HEARTBEAT_URL=
# SENTRY_DSN_API=

# ──────────────────────────────────────────────────────────────────────────────
# EXPO APPS  (apps/customer-app/.env, apps/seller-app/.env, apps/rider-app/.env)
# Only EXPO_PUBLIC_* vars are exposed to the app bundle. Changing any of these
# requires restarting Metro with a cleared cache:  npx expo start --dev-client -c
# ──────────────────────────────────────────────────────────────────────────────

# Dev API host the app talks to. Pick ONE per machine/run:
#   • Physical device (same Wi-Fi) → your Mac's LAN IP (ipconfig getifaddr en0)
#   • Android emulator             → 10.0.2.2
#   • iOS simulator                → localhost
# Production builds point at https://api.bringly.in (set in eas.json, Chunk 11).
EXPO_PUBLIC_API_HOST= 10.244.136.85

# Google Maps key for the map UI / GPS address pin (Chunk 2) and live tracking
# (Chunk 6). This is a CLIENT key — restrict it by app package + API in GCP.
# EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=

# Razorpay publishable key id for the in-app checkout sheet (Chunk 3).
# EXPO_PUBLIC_RAZORPAY_KEY_ID=rzp_test_placeholder

# Sentry DSN for the app (Chunk 10).
# EXPO_PUBLIC_SENTRY_DSN=

# ── Database backups (ops — apps/api/.env; see docs/DISASTER_RECOVERY.md) ─────
# Nightly pg_dump → a SEPARATE PRIVATE R2 bucket (never chirawa-assets), 30-day
# retention, and a mandatory pre-migration backup in production. Full variable
# list + cron line in apps/api/.env.example and the DR guide.
BACKUP_R2_BUCKET=chirawa-db-backups
BACKUP_RETENTION_DAYS=30
BACKUP_BEFORE_MIGRATE=auto
BACKUP_HEALTHCHECK_URL=
